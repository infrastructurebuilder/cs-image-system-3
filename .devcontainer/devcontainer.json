{
  "name": "cs-image-system",
  "image": "mcr.microsoft.com/devcontainers/python:3.13",
  "onCreateCommand": "curl -LsSf https://astral.sh/uv/install.sh | sh && curl --proto '=https' --tlsv1.2 -sSf https://just.systems/install.sh | bash -s -- --to ~/.local/bin",
  "postCreateCommand": "~/.local/bin/just init",
  "postStartCommand": "~/.local/bin/uv sync --frozen",
  "remoteEnv": {
    "PATH": "/root/.local/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.pylance",
        "ms-python.debugpy",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "python.analysis.diagnosticMode": "workspace",
        "python.analysis.packageIndexDepths": [
          { "name": "cs_image_system", "depth": 5, "includeAllSymbols": true }
        ],
        "python.testing.pytestEnabled": true,
        "python.testing.pytestPath": "${containerWorkspaceFolder}/.venv/bin/pytest"
      }
    }
  }
}
