#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Mykel Alvis <mykelalvis@infrastructurebuilder.org>
#
# SPDX-License-Identifier: Apache-2.0
#
# Stage 56: this GitHub Actions run's OIDC token, presented to the team's
# workload connection; the OPA access token it yields is printed on stdout
# (nothing else is), the token's public claims and the client's verdict go to
# stderr, and both tokens are masked in the job log. Needs, in the environment:
#   OPA_WORKLOAD_CONNECTION  the connection's name     (WORKLOAD_CONNECTION.md)
#   OPA_WORKLOAD_ROLE        the role's name, the hint
#   SFT_TEAM, OPA_ADDR       the OPA team and address
#   ACTIONS_ID_TOKEN_REQUEST_URL/_TOKEN   a job holding `id-token: write`
# Against a DRAFT connection OPA validates and issues nothing usable.
#
#   export OPA_TOKEN="$(scripts/opa-workload-token)"
set -euo pipefail
: "${OPA_WORKLOAD_CONNECTION:?opa-workload-token: OPA_WORKLOAD_CONNECTION (the workload connection's name) is not set}"
: "${OPA_WORKLOAD_ROLE:?opa-workload-token: OPA_WORKLOAD_ROLE (the workload role's name) is not set}"
: "${SFT_TEAM:?opa-workload-token: SFT_TEAM (the OPA team) is not set}"
: "${OPA_ADDR:?opa-workload-token: OPA_ADDR (the OPA address) is not set}"
: "${ACTIONS_ID_TOKEN_REQUEST_URL:?opa-workload-token: not a GitHub Actions job holding id-token: write}"
jwt=$(curl -fsS -H "Authorization: bearer ${ACTIONS_ID_TOKEN_REQUEST_TOKEN}" "${ACTIONS_ID_TOKEN_REQUEST_URL}" \
  | python3 -c 'import json, sys; print(json.load(sys.stdin)["value"])')
echo "::add-mask::${jwt}"
python3 - "$jwt" >&2 <<'PY'
import base64, json, sys
payload = sys.argv[1].split(".")[1]
claims = json.loads(base64.urlsafe_b64decode(payload + "=" * (-len(payload) % 4)))
for key in ("iss", "aud", "sub", "repository", "repository_owner", "ref", "ref_type", "workflow_ref", "exp"):
    print(f"claim {key}: {claims.get(key)}")
PY
export GH_OIDC_JWT="$jwt"
set +e
token=$(sft workload authenticate --team "$SFT_TEAM" --connection "$OPA_WORKLOAD_CONNECTION" \
        --role-hint "$OPA_WORKLOAD_ROLE" --jwt-env GH_OIDC_JWT 2>"${RUNNER_TEMP:-/tmp}/opa-workload-token.stderr")
rc=$?
set -e
if [ -n "$token" ]; then echo "::add-mask::${token}"; fi
{
  echo "opa-workload-token: sft workload authenticate exit ${rc}; stdout $( [ -n "$token" ] && echo 'carried a token (masked)' || echo 'empty' )"
  echo "--- stderr"
  cat "${RUNNER_TEMP:-/tmp}/opa-workload-token.stderr"
} >&2
rm -f "${RUNNER_TEMP:-/tmp}/opa-workload-token.stderr"
[ "$rc" -eq 0 ] || exit "$rc"
printf '%s' "$token"
