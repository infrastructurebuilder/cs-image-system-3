#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Mykel Alvis <mykelalvis@infrastructurebuilder.org>
#
# SPDX-License-Identifier: Apache-2.0
#
# One tofu process at a time (stage 43). OpenTofu's provider plugin cache
# (TF_PLUGIN_CACHE_DIR) is not safe under concurrent `init`: a cycle that
# overlapped the bar's tests failed on it. The suite now uses a private cache,
# and every Justfile recipe that may execute tofu runs its command through this
# wrapper -- a lock DIRECTORY under the cache (mkdir is atomic). A second holder
# is refused, loudly, with exit 75 (EX_TEMPFAIL); the lock is released when the
# command ends, however it ends.
#
#   scripts/with-tofu-lock <command> [args...]
set -euo pipefail
cache="${TF_PLUGIN_CACHE_DIR:?with-tofu-lock: TF_PLUGIN_CACHE_DIR is not set (run through just)}"
lock="$cache/.lock"
mkdir -p "$cache"
if ! mkdir "$lock" 2>/dev/null; then
  holder=$(cat "$lock/pid" 2>/dev/null || echo "?")
  echo "with-tofu-lock: another tofu-using recipe holds $lock (pid $holder) -- one tofu process at a time; wait for it, or remove that directory if the process is gone" >&2
  exit 75
fi
echo "$$" > "$lock/pid"
trap 'rm -rf "$lock"' EXIT
"$@"
