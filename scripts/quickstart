#!/usr/bin/env python3
# SPDX-FileCopyrightText: 2026 Mykel Alvis <mykelalvis@infrastructurebuilder.org>
#
# SPDX-License-Identifier: Apache-2.0
"""Run the quickstart page's own commands, and keep its prerequisites true.

    quickstart run [--page PATH] [--wheels DIR] [--passes N] [--limit SECONDS] [--keep DIR]
    quickstart prerequisites [--write | --check] [--page PATH]
    quickstart prepare --into DIR

The page, docs/QUICKSTART.md (specification 002), is proved by running
it, never by a second copy of its commands (FR-010). ``run`` reads every
fenced block whose info string is exactly ``sh``, in page order; one
command is one line, after a trailing ``\\`` has joined it with the next,
and comment and blank lines are not commands (contracts/quickstart-page.md).
Every command runs in one ``bash`` session, so an ``export`` in one box
holds for the next, in a working directory of the runner's making, with a
temporary uv tool directory: your own installed command is never touched.

The packages are this checkout's: the workspace's wheels are built (or,
with ``--wheels DIR``, taken from DIR, as the Publish workflow's job takes
its ``build`` job's files), and ``UV_OVERRIDE`` names each of the
system's distributions as a direct reference to its file, the umbrella
with the extras the page asks for (an override replaces the page's
requirement, extras and all). So the page's install, as written, takes
every one of the system's packages from the build and only third-party
ones from an index. After the first command the runner checks that every
installed package of the system came from the build; a version alone
cannot tell a build from the index's copy of the same release.

A command that fails is named with its box and exit code, the commands
after it are reported as not run, and the verdict is FAILED. A page with
no box, with more than ten commands, or whose first pass takes longer
than the limit (900 seconds, SC-001) fails too. ``--passes 2`` runs the
page a second time in the same directory (story 1, scenario 5). In CI
(``GITHUB_STEP_SUMMARY`` set) the time lines and the verdict also go to
the job summary (FR-012). Exit 0 passed; 1 failed; 2 the run could not
start (the wheels did not build, bash is absent).

``prerequisites`` prints the page's table of prerequisites, generated
from the docker starter's ``cfg/executables.yml`` (the tools the system
checks, less those the page installs itself) and ``UV_FLOOR``;
``--write`` replaces the table between the page's two markers and
``--check`` compares (Principle VIII: a version on the page comes from
the code). ``prepare`` installs exactly those floors into ``DIR/bin`` on
Linux x86_64, each download checked against its vendor's published
checksum (the docker CLI's, which its vendor does not publish, against
the digest recorded here): the clean machine of CI's job and the Publish
workflow's (research R7).
"""
from __future__ import annotations

import argparse
import hashlib
import io
import json
import os
import re
import secrets
import shutil
import subprocess
import sys
import tarfile
import tempfile
import time
import tomllib
import urllib.request
import zipfile
from collections.abc import Callable, Sequence
from dataclasses import dataclass, field
from pathlib import Path
from typing import Protocol

import yaml
from packaging.specifiers import SpecifierSet
from packaging.utils import canonicalize_name, parse_wheel_filename

REPO = Path(__file__).resolve().parents[1]
PAGE = REPO / "docs" / "QUICKSTART.md"
EXECUTABLES = REPO / "docs" / "examples" / "standard-docker" / "cfg" / "executables.yml"
OURS = "cs-image-system"
MAX_COMMANDS = 10                       # FR-008
LIMIT = 900                             # SC-001, seconds, the first pass
#: uv's floor: the oldest uv release CI's job passes on (research R11, set by spec 002's T017)
UV_FLOOR = "0.8.0"
#: the starter's tools the page installs itself, so they are no prerequisite
PAGE_INSTALLS = frozenset({"ansible-playbook"})
#: where each tool comes from: the one place that says it
WHERE = "[the daily driver, section 1.2](DAILY_DRIVER.md#12-tools-and-their-floors)"
TABLE_START = "<!-- prerequisites: generated by scripts/quickstart prerequisites --write; do not edit -->"
TABLE_END = "<!-- end of prerequisites -->"


def say_line(line: str) -> None:
    print(line, flush=True)


# ------------------------------------------------------------------------------------------ the page

@dataclass(frozen=True)
class Box:
    number: int
    commands: list[str]


def read_boxes(text: str) -> list[Box]:
    """Every ``sh`` block of the page, in order, as its commands."""
    boxes: list[Box] = []
    inside, lines = False, []
    for raw in text.splitlines():
        if not inside and raw.strip() == "```sh":
            inside, lines = True, []
            continue
        if inside and raw.strip() == "```":
            inside = False
            boxes.append(Box(len(boxes) + 1, _commands(lines)))
            continue
        if inside:
            lines.append(raw)
    return boxes


def _commands(lines: list[str]) -> list[str]:
    out: list[str] = []
    held = ""
    for line in lines:
        stripped = line.strip()
        if not held and (not stripped or stripped.startswith("#")):
            continue
        if stripped.endswith("\\"):
            held += stripped[:-1].rstrip() + " "
            continue
        out.append((held + stripped).strip())
        held = ""
    if held.strip():
        out.append(held.strip())
    return out


def page_extras(text: str) -> list[str]:
    """The extras the page's install asks of the umbrella (``cs-image-system[docker]`` gives ``["docker"]``)."""
    found = re.search(r"cs-image-system\[([A-Za-z0-9_,-]+)\]", text)
    return [e.strip() for e in found.group(1).split(",")] if found else []


# ------------------------------------------------------------------------------------------ the build

@dataclass(frozen=True)
class Built:
    version: str
    wheels: dict[str, Path] = field(default_factory=dict)       # canonical name -> its wheel


def wheels_in(directory: Path) -> dict[str, Path]:
    """Every wheel under ``directory`` (the Publish workflow's artifact nests one folder per project)."""
    return {canonicalize_name(parse_wheel_filename(w.name)[0]): w for w in sorted(directory.rglob("*.whl"))}


def build_wheels(out: Path) -> Built:
    out.mkdir(parents=True, exist_ok=True)
    done = subprocess.run(["uv", "build", "--all-packages", "--wheel", "--out-dir", str(out)], cwd=REPO,
                          env=_env(), capture_output=True, text=True)
    if done.returncode != 0:
        raise CannotStart(f"the wheels did not build (uv build, exit {done.returncode}): "
                          f"{(done.stderr or done.stdout).strip().splitlines()[-1:]}")
    version = tomllib.loads((REPO / "pyproject.toml").read_text())["project"]["version"]
    return Built(version=version, wheels=wheels_in(out))


def override_lines(wheels: dict[str, Path], extras: list[str]) -> list[str]:
    """One override per distribution of the system; the umbrella's carries the page's extras."""
    lines = []
    for name in sorted(wheels):
        shown = f"{name}[{','.join(extras)}]" if name == OURS and extras else name
        lines.append(f"{shown} @ {wheels[name].resolve().as_uri()}")
    return lines


def installed_from_build(tool_dir: Path, built: Built) -> list[str]:
    """Each installed distribution of the system in the umbrella's tool environment that did not come from
    the build, named; an empty list when every one did."""
    problems = []
    for dist in sorted(tool_dir.glob(f"{OURS}/lib/python*/site-packages/*.dist-info")):
        name, _, version = dist.name.removesuffix(".dist-info").rpartition("-")
        name = canonicalize_name(name)
        if name not in built.wheels:
            continue
        direct = dist / "direct_url.json"
        url = json.loads(direct.read_text()).get("url", "") if direct.is_file() else ""
        if not url.startswith("file:"):
            problems.append(f"{name} {version} came from an index, not the build")
    if not any(tool_dir.glob(f"{OURS}/lib/python*/site-packages/*.dist-info")):
        problems.append(f"no {OURS} tool environment under {tool_dir}")
    return problems


def _env() -> dict[str, str]:
    return {k: v for k, v in os.environ.items() if k != "VIRTUAL_ENV"}


# ------------------------------------------------------------------------------------------ the session

class Session(Protocol):
    def run(self, command: str) -> int: ...
    def close(self) -> None: ...


class BashSession:
    """One ``bash`` that every command runs in, in turn, its output passed through; each command reads
    nothing from the runner (``</dev/null``), and its exit code comes back on a line of its own."""

    def __init__(self, env: dict[str, str], cwd: Path):
        bash = shutil.which("bash", path=env.get("PATH"))
        if bash is None:
            raise CannotStart("bash is not on PATH")
        self.token = secrets.token_hex(8)
        self.proc = subprocess.Popen([bash, "--noprofile", "--norc"], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                     stderr=subprocess.STDOUT, text=True, cwd=cwd, env=env, bufsize=1)
        self._send("set -uo pipefail")

    def _send(self, text: str) -> None:
        assert self.proc.stdin is not None
        self.proc.stdin.write(text + "\n")
        self.proc.stdin.flush()

    def run(self, command: str) -> int:
        self._send(f"{{ {command}\n}} </dev/null; printf '\\n__qs_{self.token} %d\\n' $?")
        assert self.proc.stdout is not None
        for line in self.proc.stdout:
            if line.startswith(f"__qs_{self.token} "):
                return int(line.split()[1])
            if line != "\n":
                sys.stdout.write(line)
                sys.stdout.flush()
        return 255                                  # the shell ended

    def close(self) -> None:
        if self.proc.poll() is None:
            self._send("exit 0")
            self.proc.wait(timeout=30)


class CannotStart(RuntimeError):
    """The run could not start (exit 2)."""


# ------------------------------------------------------------------------------------------ run

def run(*, page: Path, wheels: Path | None, passes: int, limit: int, keep: Path | None, work: Path,
        say: Callable[[str], None] = say_line,
        session_factory: Callable[[dict[str, str], Path], Session] = BashSession,
        build: Callable[[Path], Built] = build_wheels,
        check_install: Callable[[Path, Built], list[str]] = installed_from_build,
        clock: Callable[[], float] | None = None) -> int:
    now = clock or time.monotonic
    text = page.read_text()
    boxes = read_boxes(text)
    commands = sum(len(b.commands) for b in boxes)
    summary: list[str] = []

    def verdict(line: str, rc: int) -> int:
        say(line)
        summary.append(line)
        _summarise(summary)
        return rc

    if not boxes:
        return verdict("quickstart: FAILED -- the page has no `sh` box: there is nothing to run", 1)
    if commands > MAX_COMMANDS:
        return verdict(f"quickstart: FAILED -- the page has {commands} commands; ten or fewer (FR-008)", 1)
    work.mkdir(parents=True, exist_ok=True)
    try:
        started = time.monotonic()
        if wheels is not None:
            given = wheels_in(wheels)
            if OURS not in given:
                raise CannotStart(f"no {OURS} wheel under {wheels}")
            version = parse_wheel_filename(given[OURS].name)[1]
            built = Built(version=str(version), wheels=given)
            n = len(given)
            say(f"quickstart: {n} wheel{'s' if n != 1 else ''} of {built.version} given in {wheels} (nothing built)")
        else:
            built = build(work / "wheels")
            say(f"quickstart: built {len(built.wheels)} wheels of {built.version} in "
                f"{time.monotonic() - started:.0f}s (not counted)")
    except CannotStart as e:
        return verdict(f"quickstart: FAILED -- the run could not start: {e}", 2)
    overrides = work / "overrides.txt"
    overrides.write_text("\n".join(override_lines(built.wheels, page_extras(text))) + "\n")
    tools = work / "tools"
    env = {**_env(), "UV_OVERRIDE": str(overrides), "UV_TOOL_DIR": str(tools), "UV_TOOL_BIN_DIR": str(work / "bin")}
    cwd = work / "page"
    cwd.mkdir(exist_ok=True)
    for n in range(1, passes + 1):
        try:
            session = session_factory(env, cwd)
        except CannotStart as e:
            return verdict(f"quickstart: FAILED -- the run could not start: {e}", 2)
        try:
            failed = _one_pass(boxes, session, built, tools, check_install, say, summary, now, limit if n == 1 else None)
        finally:
            session.close()
        if failed:
            return verdict(f"quickstart: FAILED -- {failed}", 1)
        if passes > 1:
            say(f"quickstart: pass {n} of {passes} passed")
    if keep is not None and (cwd / "csis-quickstart" / "generated").is_dir():
        shutil.copytree(cwd / "csis-quickstart" / "generated", keep, dirs_exist_ok=True)
    times = " each ran and succeeded" + (", twice" if passes == 2 else f", {passes} times" if passes > 2 else "")
    return verdict(f"quickstart: passed -- {commands} commands in {len(boxes)} boxes,{times}", 0)


def _one_pass(boxes: list[Box], session: Session, built: Built, tools: Path,
              check_install: Callable[[Path, Built], list[str]], say: Callable[[str], None], summary: list[str],
              now: Callable[[], float], limit: int | None) -> str | None:
    """One run of the page; the reason it failed, or None."""
    k = len(boxes)
    began = now()
    ended = began
    checked = False
    for box in boxes:
        box_began = now()
        for i, command in enumerate(box.commands):
            say(f"quickstart: box {box.number} of {k}: {command}")
            rc = session.run(command)
            if rc != 0:
                say(f"quickstart: FAILED at box {box.number} of {k}: {command} (exit {rc})")
                for rest in [*box.commands[i + 1:], *(c for b in boxes if b.number > box.number for c in b.commands)]:
                    say(f"quickstart: did not run: {rest}")
                return f"box {box.number} of {k}: {command} (exit {rc})"
        if not checked:                      # the page's install is box 1's; every package must be the build's
            checked = True
            problems = check_install(tools, built)
            if problems:
                return f"after box {box.number}'s install: {'; '.join(problems)}"
            say(f"quickstart: installed {OURS} {built.version}, the build under test")
        ended = now()
        line = f"quickstart: box {box.number} of {k} took {ended - box_began:.0f}s"
        say(line)
        summary.append(line)
    took = ended - began
    line = f"quickstart: the page took {took:.0f}s (limit {limit})" if limit else f"quickstart: the page took {took:.0f}s"
    say(line)
    summary.append(line)
    if limit and took > limit:
        return f"the page took {took:.0f}s, over its limit of {limit}s (SC-001)"
    return None


def _summarise(lines: list[str]) -> None:
    target = os.environ.get("GITHUB_STEP_SUMMARY")
    if target:
        with open(target, "a") as out:
            out.write("## quickstart\n\n" + "".join(f"- {ln.removeprefix('quickstart: ')}\n" for ln in lines) + "\n")


# ------------------------------------------------------------------------------------------ prerequisites

@dataclass(frozen=True)
class Prerequisite:
    tool: str
    version: str


def prerequisites(executables: Path = EXECUTABLES, *, uv_floor: str = UV_FLOOR) -> list[Prerequisite]:
    """uv, then every tool the starter declares that the page does not install itself, by binary."""
    declared = yaml.safe_load(executables.read_text())["executables"]
    rows = [Prerequisite("uv", f">={uv_floor}")]
    for entry in declared:
        if entry["name"] in PAGE_INSTALLS:
            continue
        written = str(entry.get("version", "")).strip()
        SpecifierSet(written)                                   # a specifier the system's check would refuse fails here too
        rows.append(Prerequisite(entry["binary"], written))
    return rows


def render_table(rows: list[Prerequisite]) -> list[str]:
    out = ["| Tool | Version | Where it comes from |", "| --- | --- | --- |"]
    out += [f"| `{r.tool}` | `{r.version}` | {WHERE} |" for r in rows]
    return out


def table(page: Path, executables: Path, mode: str, *, uv_floor: str = UV_FLOOR,
          say: Callable[[str], None] = say_line) -> int:
    rows = render_table(prerequisites(executables, uv_floor=uv_floor))
    if mode == "print":
        for line in rows:
            say(line)
        return 0
    text = page.read_text()
    if TABLE_START not in text or TABLE_END not in text:
        say(f"quickstart: {page} has no prerequisites markers ({TABLE_START} ... {TABLE_END})")
        return 1
    head, rest = text.split(TABLE_START, 1)
    current, tail = rest.split(TABLE_END, 1)
    have = [ln for ln in current.strip("\n").splitlines()]
    if mode == "write":
        page.write_text(head + TABLE_START + "\n" + "\n".join(rows) + "\n" + TABLE_END + tail)
        say(f"quickstart: the prerequisites table in {page} written from {executables} and uv's floor")
        return 0
    for i, (want, got) in enumerate(zip(rows, (have + [""] * len(rows))[:len(rows)], strict=True), 1):
        if want != got:
            say(f"quickstart: the prerequisites table differs from the code's at its row {i}: the page has "
                f"{got!r}, the code gives {want!r} (`just quickstart-table` writes it)")
            return 1
    if len(have) != len(rows):
        say(f"quickstart: the prerequisites table has {len(have)} rows, the code gives {len(rows)}")
        return 1
    say("quickstart: the prerequisites table matches cfg/executables.yml and uv's floor")
    return 0


# ------------------------------------------------------------------------------------------ prepare

class PrepareFailed(RuntimeError):
    """A tool could not be installed at its floor."""


#: the oldest release of each tool inside its floor (a lower bound written `>` names no release itself)
OLDEST = {"tofu": "1.6.0"}
#: the docker CLI's static archive has no published checksum (download.docker.com lists the archive alone):
#: its digest, read from the vendor's archive and recorded here; a new floor needs its own
DOCKER_SHA256 = {"24.0.0": "be1a3b2810171ec143b410f009d3859bdf780f3613ec848b69687ec7ef6c3952"}


def floor_versions(rows: list[Prerequisite]) -> dict[str, str]:
    """The exact release ``prepare`` installs for each tool: its floor, written out to three parts."""
    out = {}
    for row in rows:
        if row.tool == "bash":
            continue                                  # the stock image's own bash is 5.2
        lower = [s for s in SpecifierSet(row.version) if s.operator in (">=", "==")]
        version = OLDEST.get(row.tool) or (lower[0].version if lower else "")
        parts = (version.split(".") + ["0", "0"])[:3]
        out[row.tool] = ".".join(parts)
    return out


def _sources(tool: str, v: str) -> tuple[str, str | None, str]:
    """(the archive's URL, its checksum file's URL or None, the binary's path inside the archive)."""
    if tool == "uv":
        a = "uv-x86_64-unknown-linux-gnu.tar.gz"
        return f"https://github.com/astral-sh/uv/releases/download/{v}/{a}", \
            f"https://github.com/astral-sh/uv/releases/download/{v}/{a}.sha256", "uv-x86_64-unknown-linux-gnu/uv"
    if tool == "tofu":
        return f"https://github.com/opentofu/opentofu/releases/download/v{v}/tofu_{v}_linux_amd64.zip", \
            f"https://github.com/opentofu/opentofu/releases/download/v{v}/tofu_{v}_SHA256SUMS", "tofu"
    if tool == "packer":
        return f"https://releases.hashicorp.com/packer/{v}/packer_{v}_linux_amd64.zip", \
            f"https://releases.hashicorp.com/packer/{v}/packer_{v}_SHA256SUMS", "packer"
    if tool == "docker":
        return f"https://download.docker.com/linux/static/stable/x86_64/docker-{v}.tgz", None, "docker/docker"
    raise PrepareFailed(f"{tool}: no download is known for it")


def _fetch(url: str) -> bytes:
    with urllib.request.urlopen(url, timeout=120) as answer:
        return answer.read()


def prepare_tool(tool: str, version: str, into: Path, *, fetch: Callable[[str], bytes] = _fetch) -> Path:
    url, sums, member = _sources(tool, version)
    body = fetch(url)
    have = hashlib.sha256(body).hexdigest()
    if sums is None:
        want = DOCKER_SHA256.get(version, "")
    else:
        archive = url.rsplit("/", 1)[1]
        lines = [ln.split() for ln in fetch(sums).decode().splitlines() if ln.strip()]
        want = next((p[0] for p in lines if len(p) == 1 or p[-1].lstrip("*") == archive), "")
    if have != want:
        raise PrepareFailed(f"{tool}: the download's sha256 is {have}, not the published {want or '(none)'} ({url})")
    bindir = into / "bin"
    bindir.mkdir(parents=True, exist_ok=True)
    target = bindir / tool
    if url.endswith(".zip"):
        with zipfile.ZipFile(io.BytesIO(body)) as z:
            target.write_bytes(z.read(member))
    else:
        with tarfile.open(fileobj=io.BytesIO(body), mode="r:gz") as t:
            extracted = t.extractfile(member)
            if extracted is None:
                raise PrepareFailed(f"{tool}: {member} is not in {url}")
            target.write_bytes(extracted.read())
    target.chmod(0o755)
    return target


def prepare(into: Path, say: Callable[[str], None] = say_line) -> int:
    if sys.platform != "linux" or os.uname().machine not in ("x86_64", "amd64"):
        say("quickstart: prepare is for Linux x86_64 alone (CI's clean machine)")
        return 1
    try:
        for tool, version in floor_versions(prerequisites()).items():
            path = prepare_tool(tool, version, into)
            asked = subprocess.run([str(path), "version" if tool == "tofu" else "--version"],
                                   capture_output=True, text=True)
            if asked.returncode != 0 and tool != "docker":
                raise PrepareFailed(f"{tool}: {path} does not answer its version")
            say(f"quickstart: {tool} {version} installed at {path}")
    except (PrepareFailed, OSError) as e:
        say(f"quickstart: prepare FAILED -- {e}")
        return 1
    return 0


# ------------------------------------------------------------------------------------------ main

def main(argv: Sequence[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=(__doc__ or "").split("\n\n")[0])
    sub = parser.add_subparsers(dest="command", required=True)
    r = sub.add_parser("run")
    r.add_argument("--page", type=Path, default=PAGE)
    r.add_argument("--wheels", type=Path)
    r.add_argument("--passes", type=int, default=1)
    r.add_argument("--limit", type=int, default=LIMIT)
    r.add_argument("--keep", type=Path)
    p = sub.add_parser("prerequisites")
    mode = p.add_mutually_exclusive_group()
    mode.add_argument("--write", action="store_true")
    mode.add_argument("--check", action="store_true")
    p.add_argument("--page", type=Path, default=PAGE)
    q = sub.add_parser("prepare")
    q.add_argument("--into", type=Path, required=True)
    args = parser.parse_args(argv)
    if args.command == "run":
        with tempfile.TemporaryDirectory(prefix="csis-quickstart-") as td:
            return run(page=args.page, wheels=args.wheels, passes=args.passes, limit=args.limit, keep=args.keep,
                       work=Path(td))
    if args.command == "prerequisites":
        return table(args.page, EXECUTABLES, "write" if args.write else "check" if args.check else "print")
    return prepare(args.into)


if __name__ == "__main__":
    sys.exit(main())
