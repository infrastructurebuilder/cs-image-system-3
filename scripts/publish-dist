"""What a release uploads: which projects, in what order, at which versions, in which files

This file uploads nothing. It is loaded by path (it has no entry point):
the "Gather" step of .github/workflows/publish.yml reads the order, the
versions and the files from it, and the upload itself is that workflow's
`testpypi` job, by trusted publishing, with no token anywhere.

The projects are the root and every packages/* member not classified
``Private :: Do Not Upload``. The order is the dependencies': the packages
the others depend on first, `cs-image-system` last, each project's sdist and
wheel together, so an upload that is cut off leaves only complete projects,
and the top-level package appears when everything it needs is there. A
project that declares a version of its own (the contract; the SDK's members)
is looked for under that version, never under the workspace's.
"""
from __future__ import annotations

import re
import tomllib
from pathlib import Path


def _pyproject(path: Path) -> dict:
    with open(path, "rb") as f:
        return tomllib.load(f)


def _dep_name(spec: str) -> str:
    return re.split(r"[\s<>=!~;\[(]", spec.strip(), maxsplit=1)[0].lower().replace("_", "-")


PRIVATE = "Private :: Do Not Upload"


def is_published(project: dict) -> bool:
    """Whether a project is one the release uploads: every workspace member
    except one classified ``Private :: Do Not Upload`` (the extension
    template and the contract's proof), which an index refuses
    and which the workspace installs through the root's dev group."""
    return PRIVATE not in project.get("classifiers", [])


def published_pyprojects(root: Path) -> list[Path]:
    """The root project's manifest and each published packages/* member's."""
    return [path for path in [root / "pyproject.toml", *sorted(root.glob("packages/*/pyproject.toml"))]
            if is_published(_pyproject(path).get("project", {}))]


def upload_order(root: Path) -> list[str]:
    """Every project the release uploads (the root project and each published
    packages/* member), each after the workspace projects it depends on --
    the root's extras count as its dependencies -- ties by name."""
    deps: dict[str, set[str]] = {}
    for path in published_pyprojects(root):
        project = _pyproject(path).get("project", {})
        specs = list(project.get("dependencies", []))
        for extra in project.get("optional-dependencies", {}).values():
            specs += list(extra)
        deps[project["name"].lower()] = {_dep_name(d) for d in specs}
    for name in deps:
        deps[name] &= set(deps) - {name}
    order: list[str] = []
    while deps:
        ready = sorted(n for n, d in deps.items() if not d - set(order))
        if not ready:
            raise ValueError(f"the workspace's dependencies form a cycle among {sorted(deps)}")
        order.append(ready[0])
        del deps[ready[0]]
    return order


def project_versions(root: Path) -> dict[str, str]:
    """Each project's own version from its pyproject, for the projects that
    declare one: the contract (``cs-image-system-contract``) and the SDK's
    members (the kit; the two terraform libraries) carry versions of their
    own, independent of the workspace's, so their files are looked for under
    those, never under the workspace's."""
    out: dict[str, str] = {}
    for path in published_pyprojects(root):
        project = _pyproject(path).get("project", {})
        if "version" in project:
            out[project["name"].lower()] = project["version"]
    return out


def files_of(dist: Path, project: str, version: str) -> list[Path]:
    """The project's sdist and wheel(s) in dist/, the sdist first."""
    stem = f"{project.replace('-', '_')}-{version}"
    found = sorted(dist.glob(f"{stem}.tar.gz")) + sorted(dist.glob(f"{stem}-*.whl"))
    if not found:
        raise FileNotFoundError(f"dist/ holds no file of {project} {version} ({stem}.tar.gz, {stem}-*.whl)")
    return found
