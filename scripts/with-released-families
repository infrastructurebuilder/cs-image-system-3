#!/usr/bin/env python3
# SPDX-FileCopyrightText: 2026 Mykel Alvis <mykelalvis@infrastructurebuilder.org>
#
# SPDX-License-Identifier: Apache-2.0
"""Run a command with the provider families that are released from their own
repositories layered in from the index.

    with-released-families COMMAND [ARG ...]
    with-released-families --print
    with-released-families --check test|pypi
    with-released-families --newest test|pypi

A family released from a repository of its own (the Google Cloud family,
spec 005; the Okta identity plugin, spec 008) is not in this workspace's
venv: `just init` leaves its extra out, so this repository's tests pass
without it. A command that loads a tree
declaring it -- the reference configuration, a starter that needs every
provider -- runs here as ``uv run --no-sync --with=<req> ... COMMAND``: the
family is layered in for that command alone, by its extra's own requirements
in ``pyproject.toml`` (never restated), and the venv is left as it was. The
overlay runs with the one install form's index options (``INDEX_OPTIONS`` of
``cs_image_system.extras``, never restated): ``uv run --with`` ignores the
project's ``[tool.uv.sources]``, and at a release's tag each family is pinned
exactly at its newest TestPyPI release (specification 013, D1), a version
PyPI may not hold; with the options PyPI is still asked first for each name,
so between releases a range resolves as it did, and TestPyPI answers only for
a pin PyPI cannot satisfy. The
overlay resolves a family's requirements on their own, so the packages of
this checkout a family depends on (the contract and the SDK's libraries,
``CHECKOUT_SDK``) are layered in too, as this checkout's, editable: without
them the overlay takes their newest published versions and hides this
checkout's, and a command fails on what only the checkout holds yet (the
`IDS` ledger of the kit's unreleased 0.2.2 did). A checkout whose version
falls outside a family's range then fails to resolve, naming both.
``--print`` prints the ``--with=<req>`` options instead, for a recipe that
builds its own ``uv run``. ``--check INDEX`` asks the index (``test``,
TestPyPI, or ``pypi``) whether it holds a release inside every such range, a
line each, the newest one named: 0 when every range is met, 1 when one is not
(the umbrella would name a family no one can install), 2 when the index
could not be asked (nothing is guessed). A release asks it first.
``--newest INDEX`` prints, one a line, ``<name>==<version>`` for the newest
release inside each such range, with the same exits: a release pins its
umbrella's extras to them (specification 013, D1).
"""
from __future__ import annotations

import json
import os
import shlex
import sys
import tomllib
import urllib.error
import urllib.request
from collections.abc import Callable
from pathlib import Path

from packaging.requirements import Requirement
from packaging.version import InvalidVersion, Version

REPO = Path(__file__).resolve().parents[1]
#: the root's extras whose distributions are released from their own repositories
RELEASED_ELSEWHERE = ("gcloud", "okta")
#: the workspace packages the released families depend on (every family manifest's own requirements on the
#: system name these and no other), layered in from this checkout so the overlay never hides them
CHECKOUT_SDK = ("cs-image-system-contract", "cs-image-system-base", "cs-image-system-hashicorp-utils",
                "cs-image-system-tofu-roots")


def requirements(pyproject: Path = REPO / "pyproject.toml") -> list[str]:
    """Every requirement of the released-elsewhere extras, in the extras' order."""
    extras = tomllib.loads(pyproject.read_text())["project"]["optional-dependencies"]
    return [req for extra in RELEASED_ELSEWHERE for req in extras[extra]]


def checkout_sdk(root: Path = REPO) -> list[Path]:
    """The directory of each ``CHECKOUT_SDK`` package in this workspace, in that order; ``LookupError`` names
    one the workspace does not hold."""
    found: dict[str, Path] = {}
    for manifest in sorted((root / "packages").glob("*/pyproject.toml")):
        name = tomllib.loads(manifest.read_text()).get("project", {}).get("name")
        if name in CHECKOUT_SDK:
            found[name] = manifest.parent
    missing = [n for n in CHECKOUT_SDK if n not in found]
    if missing:
        raise LookupError(f"the workspace at {root} holds no package named {', '.join(missing)}")
    return [found[n] for n in CHECKOUT_SDK]


def index_options() -> list[str]:
    """The one install form's index options, a word each: PyPI asked first for each name, TestPyPI for a pin
    PyPI cannot satisfy (a family's release that TestPyPI alone holds, pinned exactly at a release's tag)."""
    from cs_image_system.extras import INDEX_OPTIONS
    return shlex.split(INDEX_OPTIONS)


def with_options(pyproject: Path = REPO / "pyproject.toml") -> list[str]:
    """The families from the index by their extras' requirements, this checkout's contract and SDK under them,
    and the index options the resolution runs with."""
    return ([f"--with={req}" for req in requirements(pyproject)]
            + [f"--with-editable={path}" for path in checkout_sdk()]
            + index_options())


INDEX_JSON = {"test": "https://test.pypi.org/pypi/{name}/json", "pypi": "https://pypi.org/pypi/{name}/json"}


class Unasked(RuntimeError):
    """The index could not be asked which versions of a project it holds."""


def published(index: str, name: str) -> set[Version]:
    """The versions of ``name`` that ``index`` holds, yanked ones left out (none when it has never held one)."""
    try:
        with urllib.request.urlopen(INDEX_JSON[index].format(name=name), timeout=30) as response:
            releases = json.load(response).get("releases") or {}
    except urllib.error.HTTPError as e:
        if e.code == 404:
            return set()
        raise Unasked(f"{name}: the index answered {e.code}") from e
    except (urllib.error.URLError, TimeoutError, ValueError) as e:
        raise Unasked(f"{name}: {e}") from e
    out: set[Version] = set()
    for text, files in releases.items():
        try:
            version = Version(text)
        except InvalidVersion:
            continue
        if files and not all(f.get("yanked") for f in files):
            out.add(version)
    return out


def check(index: str, *, asked: Callable[[str, str], set[Version]] = published,
          say: Callable[[str], None] = print, pyproject: Path = REPO / "pyproject.toml") -> int:
    """0 when ``index`` holds a release inside every released-elsewhere requirement's range, 1 when one
    has none, 2 when the index could not be asked."""
    met = True
    for text in requirements(pyproject):
        req = Requirement(text)
        try:
            inside = sorted(v for v in asked(index, req.name) if req.specifier.contains(v))
        except Unasked as e:
            say(f"with-released-families: the {index} index could not be asked: {e}")
            return 2
        if inside:
            say(f"with-released-families: {req.name}{req.specifier} -- {inside[-1]} on the {index} index")
        else:
            met = False
            say(f"with-released-families: {req.name}{req.specifier} -- NO release on the {index} index")
    return 0 if met else 1


def newest(index: str, *, asked: Callable[[str, str], set[Version]] = published,
           pyproject: Path = REPO / "pyproject.toml") -> dict[str, Version]:
    """The newest release on ``index`` inside each released-elsewhere requirement's range, by name;
    raises ``LookupError`` naming the requirement no release meets (``Unasked`` when the index could
    not be asked)."""
    found: dict[str, Version] = {}
    for text in requirements(pyproject):
        req = Requirement(text)
        inside = sorted(v for v in asked(index, req.name) if req.specifier.contains(v))
        if not inside:
            raise LookupError(f"{req.name}{req.specifier}: NO release on the {index} index")
        found[req.name] = max(found.get(req.name, inside[-1]), inside[-1])
    return found


def print_newest(index: str) -> int:
    try:
        for name, version in sorted(newest(index).items()):
            print(f"{name}=={version}")
    except Unasked as e:
        print(f"with-released-families: the {index} index could not be asked: {e}", file=sys.stderr)
        return 2
    except LookupError as e:
        print(f"with-released-families: {e}", file=sys.stderr)
        return 1
    return 0


def main(argv: list[str]) -> int:
    if argv == ["--print"]:
        print(" ".join(with_options()))
        return 0
    if len(argv) == 2 and argv[0] == "--check" and argv[1] in INDEX_JSON:
        return check(argv[1])
    if len(argv) == 2 and argv[0] == "--newest" and argv[1] in INDEX_JSON:
        return print_newest(argv[1])
    if not argv or argv[0].startswith("-"):
        print("with-released-families: name the command to run, or --print", file=sys.stderr)
        return 2
    os.execvp("uv", ["uv", "run", "--no-sync", *with_options(), *argv])
    return 1                                    # not reached: exec replaces the process


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
