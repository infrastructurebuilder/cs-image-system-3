"""How long do the sessions of a configuration have left?

    uv run python scripts/session-minutes-left <config-root>

Prints the whole minutes the soonest-expiring session the configuration's
runtimes and state backends declare has left (negative once it lapsed) and
exits 0; prints nothing and exits 1 when no declared session has a readable
expiry. Each plugin reads its own session (the preflight's hook); a token
the provider's tooling renews still reports the token's own expiry here,
because a renewal can fail once the token has lapsed. The release recipe
says the number on the line that reports the sessions present: a release
takes about an hour, and a login may last one.
"""
from __future__ import annotations

import math
import sys
from pathlib import Path

from cs_image_system.base.commands.preflight import session_minutes_left


def main(argv: list[str]) -> int:
    if len(argv) != 2:
        print(__doc__.strip().splitlines()[2].strip(), file=sys.stderr)
        return 2
    left = session_minutes_left(Path(argv[1]))
    if left is None:
        return 1
    print(math.floor(left))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
