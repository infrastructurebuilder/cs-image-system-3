#!/usr/bin/env python3
# SPDX-FileCopyrightText: 2026 Mykel Alvis <mykelalvis@infrastructurebuilder.org>
#
# SPDX-License-Identifier: Apache-2.0
"""Build one starter's template-repository tree (stage 66)

    uv run python scripts/starter-tree <name> <version> <dest>
    uv run python scripts/starter-tree --list      # each starter and its template repository

The template repositories (`infrastructurebuilder/cs-image-system-starter-
<name>`, "Use this template" on GitHub) are generated from
`docs/examples/<name>` per final release and never edited there. The tree
is what `init-config` writes into an empty directory (`starters.write_starter`:
the skeleton under the starter's overlay, the installed plugins' terraform
modules materialised into `tfmodules/` with their stamps), with three
generated changes and nothing else:

- `.csis-version` holds the version, as `init-config` writes it;
- README.md opens with a generated header: what it is, where it comes from,
  that it takes no pull requests, and that the TEST age identity committed
  with every starter must be replaced before any real value is stored;
- every Markdown link that leaves the starter's own tree (into the system
  repository's documents, or to another starter) becomes a link to that
  file in the system repository at the release's tag, since a relative one
  would point nowhere in a repository of its own.

The modules a template carries are those of the plugins installed where
the script runs, so the publishing checkout installs every plugin (the
workspace does). `<dest>` must not exist or be empty. Prints the files it
wrote.
"""
from __future__ import annotations

import argparse
import sys
from pathlib import Path

from cs_image_system.system.starter_links import SYSTEM_REPO
from cs_image_system.system.starters import write_starter

OWNER = "infrastructurebuilder"
TEMPLATE_PREFIX = "cs-image-system-starter-"
HEADER_MARK = "<!-- generated by cs-image-system's scripts/starter-tree; do not edit here -->"


def starters() -> tuple[str, ...]:
    from cs_image_system.system.starters import STARTERS
    return tuple(STARTERS)


def template_repo(name: str) -> str:
    return f"{OWNER}/{TEMPLATE_PREFIX}{name}"


def header(name: str, version: str) -> str:
    source = f"https://github.com/{SYSTEM_REPO}/tree/v{version}/docs/examples/{name}"
    return (f"{HEADER_MARK}\n"
            f"> **This repository is generated.** It is cs-image-system's starter `{name}`\n"
            f"> ([`docs/examples/{name}`]({source}) at {version}), published with each final\n"
            f"> release, and it takes no pull requests: a change to the starter goes to\n"
            f"> [the system repository](https://github.com/{SYSTEM_REPO}). Start yours with\n"
            f"> \"Use this template\". **Before you store any real value**, replace the TEST\n"
            f"> age identity committed here (`.age-identity`): this README says how.\n\n")


def build(name: str, version: str, dest: Path) -> list[str]:
    if name not in starters():
        raise SystemExit(f"starter-tree: no starter named {name!r} (known: {', '.join(starters())})")
    if dest.exists() and any(dest.iterdir()):
        raise SystemExit(f"starter-tree: {dest} exists and is not empty")
    files = write_starter(name, dest, version=version)      # the links and .csis-version are its own work
    readme = dest / "README.md"
    readme.write_text(header(name, version) + readme.read_text())
    return files


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(description="Build one starter's template-repository tree.")
    ap.add_argument("--list", action="store_true", help="print each starter and its template repository")
    ap.add_argument("name", nargs="?")
    ap.add_argument("version", nargs="?")
    ap.add_argument("dest", type=Path, nargs="?")
    args = ap.parse_args(argv)
    if args.list:
        for name in starters():
            print(f"{name} {template_repo(name)}")
        return 0
    if not (args.name and args.version and args.dest):
        ap.error("name, version and dest are required (or --list)")
    files = build(args.name, args.version, args.dest)
    print(f"starter-tree: {args.name} at {args.version}: {len(files)} files in {args.dest} "
          f"(for {template_repo(args.name)})")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
