# Packer configuration for image basic-rhel-8 generated by PackerEbsImageBuilder (pckr-ebs-ans)
data "amazon-ami" "basic-rhel-8_aws-east2-runtime" {
    filters = {
        image-id = "ami-0feedfacecafebeef",
    }
    owners = [
        "amazon",
    ]
    profile = "noaa"
}
source "amazon-ebs" "basic-rhel-8" {
    source_ami = data.amazon-ami.basic-rhel-8_aws-east2-runtime.id
    ami_name = "basic-rhel-8-aws-east2-runtime-20260826_120000"
    instance_type = "t3.medium"
    region = "us-east-2"
    vpc_id = "vpc-0c78d0d63b7a100df"
    subnet_id = "subnet-09f79018af845358a"
    tags = {
        csis_series         = "basic-rhel-8",
        csis_parent         = "vendor",
        csis_run            = "2026_08_26t12_00_00",
        csis_fingerprint    = "b0912c937c5ac92d",
        csis_identity_types = "okta",
        csis_storage_types  = "ebs,efs,s3",
    }
    associate_public_ip_address = false
    profile = "noaa"
    ssh_interface = "session_manager"
    iam_instance_profile = "AmazonSSMRoleForInstancesQuickSetup"
    ssh_timeout = "15m"
    user_data = "#!/bin/bash\nset -x\ndl() { if command -v curl >/dev/null 2>&1; then curl -fsSL \"$1\" -o \"$2\"; else wget -qO \"$2\" \"$1\"; fi; }\nif ! command -v amazon-ssm-agent >/dev/null 2>&1 && [ ! -x /snap/bin/amazon-ssm-agent ]; then\n  R=us-east-2\n  if command -v curl >/dev/null 2>&1; then R=$(curl -s http://169.254.169.254/latest/meta-data/placement/region || echo us-east-2);\n  elif command -v wget >/dev/null 2>&1; then R=$(wget -qO- http://169.254.169.254/latest/meta-data/placement/region || echo us-east-2); fi\n  if command -v dnf >/dev/null 2>&1; then dnf install -y \"https://s3.$R.amazonaws.com/amazon-ssm-$R/latest/linux_amd64/amazon-ssm-agent.rpm\";\n  elif command -v yum >/dev/null 2>&1; then yum install -y \"https://s3.$R.amazonaws.com/amazon-ssm-$R/latest/linux_amd64/amazon-ssm-agent.rpm\";\n  elif command -v dpkg >/dev/null 2>&1; then\n    command -v curl >/dev/null 2>&1 || command -v wget >/dev/null 2>&1 || { apt-get -o DPkg::Lock::Timeout=600 update -qq; apt-get -o DPkg::Lock::Timeout=600 install -y wget; }\n    dl \"https://s3.$R.amazonaws.com/amazon-ssm-$R/latest/debian_amd64/amazon-ssm-agent.deb\" /tmp/ssm.deb && dpkg -i /tmp/ssm.deb; fi\nfi\nsystemctl enable --now amazon-ssm-agent 2>/dev/null || true"
    ssh_username = "ec2-user"
    force_deregister = !var.release
    
    launch_block_device_mappings {
        device_name = "/dev/sda1"
        volume_type = "gp3"
        delete_on_termination = true
        volume_size = 200
    }
}