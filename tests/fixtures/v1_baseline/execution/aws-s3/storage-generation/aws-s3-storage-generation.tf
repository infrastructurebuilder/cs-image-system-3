# Terraform configuration for storages generated by TofuS3StorageBuilder (aws-s3)
terraform {
    required_providers {
        aws = {
            source = "hashicorp/aws"
        }
    }
    
    backend "s3" {
    }
}
provider "aws" {
    region = "us-east-2"
    profile = "noaa"
    alias = "aws_s3"
}