# Terraform configuration for storages generated by TofuEbsStorageBuilder (aws-ebs)
terraform {
    required_providers {
        aws = {
            source = "hashicorp/aws"
        }
    }
    
    backend "s3" {
    }
}
provider "aws" {
    region = "us-east-2"
    profile = "noaa"
    alias = "aws_ebs"
}
data "terraform_remote_state" "oktagroups" {
    backend = "s3"
    
    config = {
        bucket = "noaa-ioos-cloud-sandbox-tfstate"
        key = "statefiles/csia-image-system-test/oktagroups.tfstate"
        region = "us-east-2"
        profile = "noaa"
    }
}