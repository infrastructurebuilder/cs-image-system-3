# Terraform configuration for Okta groups generated by OktaTfGroupRoBuilder (okta-groups-ro)

terraform {
    required_providers {
        okta = {
            source = "okta/okta"
            version = ">= 6.0"
        }
        
        external = {
            source = "hashicorp/external"
        }
    }
    
    backend "local" {
    }
}

provider "okta" {
    org_name = "noaa"
    base_url = "okta.com"
    alias = "okta_groups_ro"
}
provider "external" {
    alias = "okta_groups_ro"
}
