# Terraform configuration for Okta groups generated by OktaTfGroupBuilder (oktagroups)

terraform {
    required_providers {
        oktapam = {
            source = "okta/oktapam"
            version = ">= 0.6.3"
        }
        
        external = {
            source = "hashicorp/external"
        }
    }
    
    backend "local" {
    }
}

provider "oktapam" {
    oktapam_key = var.nos_coastal_modeling_cloud_sandbox_key
    oktapam_secret = var.nos_coastal_modeling_cloud_sandbox_secret
    oktapam_api_host = "https://noaa.pam.okta.com"
    oktapam_team = "nos-coastal-modeling-cloud-sandbox"
    alias = "oktagroups"
}
provider "external" {
    alias = "oktagroups"
}
