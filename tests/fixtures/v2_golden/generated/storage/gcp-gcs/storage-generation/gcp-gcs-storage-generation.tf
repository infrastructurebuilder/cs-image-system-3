# Terraform configuration for GCP storages generated by TofuGcsStorageBuilder (gcp-gcs)
terraform {
    required_providers {
        google = {
            source = "hashicorp/google"
        }
    }
    
    backend "s3" {
    }
}
provider "google" {
    project = "csis-sandbox"
    region = "us-east1"
    zone = "us-east1-b"
    alias = "gcp_gcs"
}