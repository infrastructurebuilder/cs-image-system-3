# Terraform module call for storage container_data generated by TofuDockerVolumeStorageBuilder (docker-volume)
# allowed groups: pxgroup (gids by remote-state reference); public_read=false; requested state: active
module "storage_container_data" {
  source = "../../../../../tfmodules/docker_volume"
  providers = { docker = docker.docker_volume }
  name = "container_data"
  labels = { "csis_config" = "cs-image-action-test", "csis_group_pxgroup" = "true", "csis_storage" = "container_data", "project" = "MyProject", "purpose" = "data" }
}
output "storage_container_data" {
    value = module.storage_container_data
    description = "Outputs of storage container_data for remote-state consumers"
}