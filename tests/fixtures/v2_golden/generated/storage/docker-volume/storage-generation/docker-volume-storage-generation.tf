# Terraform configuration for container volumes generated by TofuDockerVolumeStorageBuilder (docker-volume)
# The daemon's address is not here: every tofu process of this root carries the
# runtime's DOCKER_HOST or DOCKER_CONTEXT in its environment (stage 103 branch 2).
terraform {
    required_providers {
        docker = {
            source = "kreuzwerker/docker"
        }
    }
    
    backend "local" {
    }
}
provider "docker" {
    alias = "docker_volume"
}