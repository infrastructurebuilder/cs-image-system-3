# Terraform module call for storage efs-storage generated by TofuEfsStorageBuilder (aws-efs)
# allowed groups: coops, stofs (gids by remote-state reference); public_read=false; requested state: active
module "storage_efs_storage" {
  source = "../../../../../tfmodules/aws_storage_efs"
  providers = { aws = aws.aws_efs }
  performance_mode = "generalPurpose"
  encrypted = true
  name = "efs-storage"
  transition_to_ia = "AFTER_30_DAYS"
  access_points = {
    "coops" = {
      "gid" = data.terraform_remote_state.oktagroups.outputs.group_gids["coops"]
      "path" = "/coops"
      "permissions" = "2775"
    }
    "stofs" = {
      "gid" = data.terraform_remote_state.oktagroups.outputs.group_gids["stofs"]
      "path" = "/stofs"
      "permissions" = "2775"
    }
  }
  vpc_id = "vpc-0c78d0d63b7a100df"
  mount_target_subnet_ids = ["subnet-09f79018af845358a", "subnet-00075cfbfcbc8f2cf"]
  client_security_group_ids = ["sg-03015ec107ae5f81a"]
  tags = { "Environment" = "Development", "Project" = "MyProject" }
}
output "storage_efs_storage" {
    value = module.storage_efs_storage
    description = "Outputs of storage efs-storage for remote-state consumers"
}