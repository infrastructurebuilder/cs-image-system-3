# Terraform configuration for storages generated by TofuEfsStorageBuilder (aws-efs)
terraform {
    required_providers {
        aws = {
            source = "hashicorp/aws"
        }
    }
    
    backend "s3" {
    }
}
provider "aws" {
    region = "us-east-2"
    profile = "noaa"
    alias = "aws_efs"
}
data "terraform_remote_state" "oktagroups" {
    backend = "local"
    
    config = {
        path = "../../../../state/oktagroups.tfstate"
    }
}