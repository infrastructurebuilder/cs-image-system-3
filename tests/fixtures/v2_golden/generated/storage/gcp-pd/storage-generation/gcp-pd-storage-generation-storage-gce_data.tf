# Terraform module call for storage gce_data generated by TofuPdStorageBuilder (gcp-pd)
# allowed groups: coops (gids by remote-state reference); public_read=false; requested state: active
module "storage_gce_data" {
  source = "../../../../../tfmodules/gcp_storage_pd"
  providers = { google = google.gcp_pd }
  name = "gce-data"
  size = 30
  disk_type = "pd-standard"
  labels = { "csis_group_coops" = "true", "csis_storage" = "gce_data" }
  zone = "us-east1-b"
}
output "storage_gce_data" {
    value = module.storage_gce_data
    description = "Outputs of storage gce_data for remote-state consumers"
}