# Terraform configuration for GCP storages generated by TofuPdStorageBuilder (gcp-pd)
terraform {
    required_providers {
        google = {
            source = "hashicorp/google"
        }
    }
    
    backend "s3" {
    }
}
provider "google" {
    project = "csis-sandbox"
    region = "us-east1"
    zone = "us-east1-b"
    alias = "gcp_pd"
}
data "terraform_remote_state" "oktagroups" {
    backend = "local"
    
    config = {
        path = "../../../../state/oktagroups.tfstate"
    }
}