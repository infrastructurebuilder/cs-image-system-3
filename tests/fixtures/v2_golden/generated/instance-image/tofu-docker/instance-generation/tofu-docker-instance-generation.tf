# Terraform configuration for containers generated by TofuDockerInstanceBuilder (tofu-docker)
# The daemon's address is not here: every tofu process of this root carries the
# runtime's DOCKER_HOST or DOCKER_CONTEXT in its environment (stage 103 branch 2).
terraform {
    required_providers {
        docker = {
            source = "kreuzwerker/docker"
            version = ">= 3.0.0"
        }
    }
    
    backend "local" {
    }
}
provider "docker" {
    alias = "tofu_docker"
}
variable "container_test_image" {
    type = string
    default = ""
}
variable "enrollment_token" {
    type = string
    default = ""
    description = "Identity enrollment token handed to instances at launch (TF_VAR_...); empty = no enrollment"
    sensitive = true
}
data "terraform_remote_state" "aws_efs" {
    backend = "s3"
    
    config = {
        bucket = "my-east1-tfstate-bucket"
        key = "statefiles/csia/aws_efs.tfstate"
        region = "us-east-1"
        profile = "noaa"
    }
}
data "terraform_remote_state" "aws_ebs" {
    backend = "s3"
    
    config = {
        bucket = "my-east1-tfstate-bucket"
        key = "statefiles/csia/aws_ebs.tfstate"
        region = "us-east-1"
        profile = "noaa"
    }
}
data "terraform_remote_state" "aws_s3" {
    backend = "s3"
    
    config = {
        bucket = "my-east1-tfstate-bucket"
        key = "statefiles/csia/aws_s3.tfstate"
        region = "us-east-1"
        profile = "noaa"
    }
}
data "terraform_remote_state" "gcp_pd" {
    backend = "s3"
    
    config = {
        bucket = "my-east1-tfstate-bucket"
        key = "statefiles/csia/gcp_pd.tfstate"
        region = "us-east-1"
        profile = "noaa"
    }
}
data "terraform_remote_state" "gcp_gcs" {
    backend = "s3"
    
    config = {
        bucket = "my-east1-tfstate-bucket"
        key = "statefiles/csia/gcp_gcs.tfstate"
        region = "us-east-1"
        profile = "noaa"
    }
}
data "terraform_remote_state" "docker_volume" {
    backend = "local"
    
    config = {
        path = "../../../../state/docker_volume.tfstate"
    }
}