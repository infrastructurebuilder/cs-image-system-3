# Terraform module call for container container-test generated by TofuDockerInstanceBuilder (tofu-docker)
# owning group: pxgroup (via image imgfile-container); launch parameters recorded in meta-state/launch-params.yaml (N26)
module "instance_container_test" {
  source = "../../../../../tfmodules/docker_container"
  providers = { docker = docker.tofu_docker }
  name = "container-test"
  hostname = "container-test-001"
  image = var.container_test_image
  image_tag = "csis/fixture:imgfile-container-pckr-docker"
  cpus = "1.0"
  memory = 1024
  network = "bridge"
  labels = { "csis_config" = "cs-image-action-test", "csis_generation" = "1", "csis_instance" = "container-test", "purpose" = "proof" }
  launch_script = templatefile("${path.module}/launch-container_test.sh.tftpl", {
    "ebs" = {}
    "efs" = {}
    "enrollment_token" = ""
    "group_gid" = 3101
  })
  volumes = {
    "container_data" = {
      "container_path" = "/mnt/data"
      "volume_name" = data.terraform_remote_state.docker_volume.outputs.storage_container_data.volume_name
    }
  }
}