# Terraform configuration for instances generated by TofuInstanceBuilder (open-tofu)
terraform {
    required_providers {
        aws = {
            source = "hashicorp/aws"
            version = ">= 4.0.0"
        }
    }
    
    backend "s3" {
    }
}
provider "aws" {
    region = "us-east-2"
    profile = "noaa"
    alias = "open_tofu"
}
variable "test_ami_id" {
    type = string
    default = ""
}
variable "test2_ami_id" {
    type = string
    default = ""
}
variable "sft_enrollment_token" {
    type = string
    default = ""
    description = "Identity enrollment token handed to instances at launch (TF_VAR_...); empty = no enrollment"
    sensitive = true
}
data "terraform_remote_state" "aws_efs" {
    backend = "s3"
    
    config = {
        bucket = "noaa-ioos-cloud-sandbox-tfstate"
        key = "statefiles/csia-image-system-test/aws_efs.tfstate"
        region = "us-east-2"
        profile = "noaa"
    }
}
data "terraform_remote_state" "aws_ebs" {
    backend = "s3"
    
    config = {
        bucket = "noaa-ioos-cloud-sandbox-tfstate"
        key = "statefiles/csia-image-system-test/aws_ebs.tfstate"
        region = "us-east-2"
        profile = "noaa"
    }
}
data "terraform_remote_state" "aws_s3" {
    backend = "s3"
    
    config = {
        bucket = "noaa-ioos-cloud-sandbox-tfstate"
        key = "statefiles/csia-image-system-test/aws_s3.tfstate"
        region = "us-east-2"
        profile = "noaa"
    }
}
data "terraform_remote_state" "gcp_pd" {
    backend = "s3"
    
    config = {
        bucket = "noaa-ioos-cloud-sandbox-tfstate"
        key = "statefiles/csia-image-system-test/gcp_pd.tfstate"
        region = "us-east-2"
        profile = "noaa"
    }
}
data "terraform_remote_state" "gcp_gcs" {
    backend = "s3"
    
    config = {
        bucket = "noaa-ioos-cloud-sandbox-tfstate"
        key = "statefiles/csia-image-system-test/gcp_gcs.tfstate"
        region = "us-east-2"
        profile = "noaa"
    }
}
data "terraform_remote_state" "oktagroups" {
    backend = "s3"
    
    config = {
        bucket = "noaa-ioos-cloud-sandbox-tfstate"
        key = "statefiles/csia-image-system-test/oktagroups.tfstate"
        region = "us-east-2"
        profile = "noaa"
    }
}
data "aws_vpc" "csis_instances" {
  provider    = aws.open_tofu
  id = "vpc-0c78d0d63b7a100df"
}
resource "aws_security_group" "csis_instances" {
  provider    = aws.open_tofu
  name_prefix = "csis-instances-"
  description = "cs-image-system instances: SSH from the session relay; all egress"
  vpc_id      = data.aws_vpc.csis_instances.id
  ingress {
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    security_groups = ["sg-03015ec107ae5f81a"]
  }
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
  tags = { Name = "csis-instances" }
  # replacements must create the successor first: instances
  # wear this group, so a delete-first plan hits
  # DependencyViolation (found live)
  lifecycle { create_before_destroy = true }
}