# Terraform configuration for GCE instances generated by TofuGceInstanceBuilder (tofu-gce)
terraform {
    required_providers {
        google = {
            source = "hashicorp/google"
        }
    }
    
    backend "s3" {
    }
}
provider "google" {
    project = "csis-sandbox"
    region = "us-east1"
    zone = "us-east1-b"
    alias = "tofu_gce"
}
variable "gce_test_image" {
    type = string
    default = ""
}
variable "sft_enrollment_token" {
    type = string
    default = ""
    description = "Identity enrollment token handed to instances at launch (TF_VAR_...); empty = no enrollment"
    sensitive = true
}
data "terraform_remote_state" "aws_efs" {
    backend = "s3"
    
    config = {
        bucket = "my-east1-tfstate-bucket"
        key = "statefiles/csia/aws_efs.tfstate"
        region = "us-east-1"
        profile = "noaa"
    }
}
data "terraform_remote_state" "aws_ebs" {
    backend = "s3"
    
    config = {
        bucket = "my-east1-tfstate-bucket"
        key = "statefiles/csia/aws_ebs.tfstate"
        region = "us-east-1"
        profile = "noaa"
    }
}
data "terraform_remote_state" "aws_s3" {
    backend = "s3"
    
    config = {
        bucket = "my-east1-tfstate-bucket"
        key = "statefiles/csia/aws_s3.tfstate"
        region = "us-east-1"
        profile = "noaa"
    }
}
data "terraform_remote_state" "gcp_pd" {
    backend = "s3"
    
    config = {
        bucket = "my-east1-tfstate-bucket"
        key = "statefiles/csia/gcp_pd.tfstate"
        region = "us-east-1"
        profile = "noaa"
    }
}
data "terraform_remote_state" "gcp_gcs" {
    backend = "s3"
    
    config = {
        bucket = "my-east1-tfstate-bucket"
        key = "statefiles/csia/gcp_gcs.tfstate"
        region = "us-east-1"
        profile = "noaa"
    }
}
data "terraform_remote_state" "oktagroups" {
    backend = "s3"
    
    config = {
        bucket = "noaa-ioos-cloud-sandbox-tfstate"
        key = "statefiles/csia-image-system-test/oktagroups.tfstate"
        region = "us-east-2"
        profile = "noaa"
    }
}