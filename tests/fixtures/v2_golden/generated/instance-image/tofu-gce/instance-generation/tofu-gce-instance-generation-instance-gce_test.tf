# Terraform module call for GCE instance gce-test generated by TofuGceInstanceBuilder (tofu-gce)
# owning group: coops (via image imgfile-basic-dask); launch parameters recorded in meta-state/launch-params.yaml (N26)
module "instance_gce_test" {
  source = "../../../../../tfmodules/gce_instance"
  providers = { google = google.tofu_gce }
  name = "gce-test"
  image = var.gce_test_image
  image_family = "imgfile-basic-dask"
  machine_type = "e2-micro"
  zone = "us-east1-b"
  subnetwork = "projects/csis-sandbox/regions/us-east1/subnetworks/default"
  public_ip = false
  startup_script = templatefile("${path.module}/user-data-gce_test.sh.tftpl", {
    "efs" = {}
    "filestore" = {}
    "group_gid" = data.terraform_remote_state.oktagroups.outputs.group_gids["coops"]
    "sft_enrollment_token" = var.sft_enrollment_token
  })
  attached_disks = {
    "gce_data" = {
      "device_name" = "gce-data"
      "disk_self_link" = data.terraform_remote_state.gcp_pd.outputs.storage_gce_data.self_link
    }
  }
}