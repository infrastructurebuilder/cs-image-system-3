# Build configuration for Packer EBS Ansible Builder generated by PackerDockerImageBuilder (pckr-docker)
build {
  name = "pckr-docker-block-000"
  sources = [
"source.docker.imgfile-container"
]
  # before anything else: the build machine settles (docker-fixture)
  provisioner "shell" {
    only   = ["docker.imgfile-container"]
    inline = [
      "# before any package work: the machine's own first-boot script has ended (bounded)",
      "if command -v cloud-init >/dev/null 2>&1; then timeout 300 cloud-init status --wait >/dev/null 2>&1 || true; fi",
      "# a container settles at once; it may lack sudo and python3, which the steps that follow use",
      "if ! command -v sudo >/dev/null 2>&1 || ! command -v python3 >/dev/null 2>&1; then if command -v apt-get >/dev/null 2>&1; then apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq sudo python3 procps >/dev/null; elif command -v dnf >/dev/null 2>&1; then dnf -y -q install sudo python3 procps-ng >/dev/null; elif command -v microdnf >/dev/null 2>&1; then microdnf -y install sudo python3 procps-ng >/dev/null; fi; fi",
      "# the step runner: a step that fails on a held package database is run again (never in the image: /run is a tmpfs)",
      "sudo tee /run/csis-step >/dev/null <<'CSIS_STEP'",
      "#!/bin/sh",
      "# cs-image-system: runs ONE step of a bake. A step that fails while the package",
      "# database is held by another process is run again after a wait; any other",
      "# failure is the step's own and is returned at once.",
      "tries=\"$${CSIS_STEP_TRIES:-10}\"",
      "pause=\"$${CSIS_STEP_WAIT:-30}\"",
      "out=\"$(mktemp)\" || exit 1",
      "trap 'rm -f \"$out\" \"$out.rc\"' EXIT",
      "n=1",
      "while :; do",
      "  { \"$@\" 2>&1; echo \"$?\" > \"$out.rc\"; } | tee \"$out\"",
      "  rc=\"$(cat \"$out.rc\")\"",
      "  [ \"$rc\" = 0 ] && exit 0",
      "  [ \"$n\" -ge \"$tries\" ] && exit \"$rc\"",
      "  grep -Eq 'transaction lock|Could not get lock|dpkg frontend lock|Unable to lock the administration directory' \"$out\" || exit \"$rc\"",
      "  echo \"csis-step: the package database was held by another process (attempt $n of $tries); this step runs again in $pause seconds\"",
      "  n=$((n + 1))",
      "  sleep \"$pause\"",
      "done",
      "CSIS_STEP",
      "sudo chmod 0755 /run/csis-step",
    ]
  }
# Modifications for container-shell of type bash-remote (shell)
provisioner "shell" {
  only = ["docker.imgfile-container"]
  inline = [
    "echo hello",
  ]
  execute_command = "chmod +x {{ .Path }}; if [ -r /run/csis-step ]; then {{ .Vars }} sh /run/csis-step {{ .Path }}; else {{ .Vars }} {{ .Path }}; fi"
}
# Modifications for container-ansible of type ansible-default
provisioner "shell" {
  only = ["docker.imgfile-container"]
  execute_command = "chmod +x {{ .Path }}; if [ -r /run/csis-step ]; then {{ .Vars }} sh /run/csis-step {{ .Path }}; else {{ .Vars }} {{ .Path }}; fi"
  inline = [
    "test -x /usr/local/bin/csis-ansible-python || { sudo sh -c 'for v in 3.12 3.11 3.9; do command -v python$v >/dev/null 2>&1 && exit 0; dnf -y install python$v >/dev/null 2>&1 && exit 0; done; command -v python3 >/dev/null 2>&1 || dnf -y install python3 || yum -y install python3'; P=$(ls /usr/bin/python3.[0-9]* 2>/dev/null | grep -v config | sort -V | tail -1); [ -n \"$P\" ] || P=$(command -v python3); sudo ln -sf \"$P\" /usr/local/bin/csis-ansible-python; }",
  ]
}
provisioner "ansible" {
  only = ["docker.imgfile-container"]
  playbook_file = "setup_dask.yml"
  user = "root"
  extra_arguments = ["-e", "ansible_python_interpreter=/usr/local/bin/csis-ansible-python", "--extra-vars", "ansible_connection=docker ansible_host=csis-bake-docker-fixture-imgfile-container"]
}
  # identity activation for owning group 'pxgroup' (posix)
  provisioner "shell" {
    only   = ["docker.imgfile-container"]
    execute_command = "chmod +x {{ .Path }}; if [ -r /run/csis-step ]; then {{ .Vars }} sh /run/csis-step {{ .Path }}; else {{ .Vars }} {{ .Path }}; fi"
    inline = [
      "# identity activation for group 'pxgroup' (posix) on image imgfile-container",
      "sudo bash -s <<'CSIS_POSIX_ACCOUNTS'",
      "#!/usr/bin/env bash",
      "# cs-image-system posix accounts (stage 75): idempotent; adopts what is equal, refuses what differs",
      "set -euo pipefail",
      "conflict() { echo \"posix accounts: $*\" >&2; exit 3; }",
      "# group pxgroup (gid 3101)",
      "if getent group pxgroup >/dev/null; then",
      "  have=$(getent group pxgroup | cut -d: -f3)",
      "  [ \"$have\" = 3101 ] || conflict \"group pxgroup has gid $have here; the configuration says 3101\"",
      "else",
      "  if other=$(getent group 3101 | cut -d: -f1) && [ -n \"$other\" ]; then",
      "    conflict \"gid 3101 belongs to group $other here; the configuration gives it to pxgroup\"",
      "  fi",
      "  groupadd -g 3101 pxgroup",
      "fi",
      "CSIS_POSIX_ACCOUNTS",
    ]
  }
  # local modification bundle for imgfile-container -> /opt/csis/mods (re-run with `csis-mods rerun`)
  provisioner "shell" {
    only   = ["docker.imgfile-container"]
    inline = ["mkdir -p /tmp/csis-mods"]
  }
  provisioner "file" {
    only        = ["docker.imgfile-container"]
    source      = "csis-mods/imgfile-container/"
    destination = "/tmp/csis-mods"
  }
  provisioner "shell" {
    only   = ["docker.imgfile-container"]
    inline = [
      "sudo rm -rf /opt/csis/mods && sudo mkdir -p /opt/csis",
      "sudo mv /tmp/csis-mods /opt/csis/mods",
      "sudo install -m 0755 /opt/csis/mods/csis-mods /usr/local/bin/csis-mods",
      "sudo chmod -R go-w /opt/csis/mods",
    ]
  }
  # in-bake verification for instance image imgfile-container: 3 assertion(s)
  provisioner "shell" {
    only   = ["docker.imgfile-container"]
    inline = [
      "set -e",
      "# verify: group 'pxgroup' stands with gid 3101",
      "test \"$(getent group pxgroup | cut -d: -f3)\" = '3101'",
      "if ! rpm -q git >/dev/null 2>&1 && ! { command -v dpkg >/dev/null 2>&1 && dpkg -s git >/dev/null 2>&1; }; then printf 'package %s is not installed\\n' git >&2; exit 1; fi",
      "( python3 --version ) 2>&1 | grep -q -- 'Python 3'",
    ]
  }
  # stage 103: the build's names are tags (imgfile-container); the floating tag is the series' newest
  post-processor "docker-tag" {
    only       = ["docker.imgfile-container"]
    repository = "csis/fixture"
    tags       = ["imgfile-container-pckr-docker-20260826_120000", "imgfile-container-pckr-docker"]
  }
  post-processor "manifest" {
    output     = "manifest.json"
    strip_path = true
  }
}