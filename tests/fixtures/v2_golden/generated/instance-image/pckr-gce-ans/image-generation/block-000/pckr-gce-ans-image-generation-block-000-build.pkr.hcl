# Build configuration for Packer EBS Ansible Builder generated by PackerGceImageBuilder (pckr-gce-ans)
build {
  name = "pckr-gce-ans-block-000"
  sources = [
"source.googlecompute.imgfile-basic-dask"
]
# Modifications for dask-setup-jeffy of type ansible-default
provisioner "shell" {
  only = ["googlecompute.imgfile-basic-dask"]
  inline = [
    "test -x /usr/local/bin/csis-ansible-python || { for v in 3.12 3.11 3.9; do command -v python$v >/dev/null 2>&1 && break; sudo dnf -y install python$v >/dev/null 2>&1 && break; done; P=$(ls /usr/bin/python3.[0-9]* 2>/dev/null | grep -v config | sort -V | tail -1); [ -n \"$P\" ] || P=$(command -v python3); sudo ln -sf \"$P\" /usr/local/bin/csis-ansible-python; }",
  ]
}
provisioner "ansible" {
  only = ["googlecompute.imgfile-basic-dask"]
  playbook_file = "setup_dask.yml"
  user = "packer"
  extra_arguments = ["-e", "ansible_python_interpreter=/usr/local/bin/csis-ansible-python"]
}
# Modifications for derivative-setup of type bash-remote (shell)
provisioner "shell" {
  only = ["googlecompute.imgfile-basic-dask"]
  scripts = ["mod_image.sh"]
}
provisioner "shell" {
  only = ["googlecompute.imgfile-basic-dask"]
  inline = [
    "for p in git; do rpm -q \"$p\" >/dev/null 2>&1 || dpkg -s \"$p\" >/dev/null 2>&1 || { command -v dnf >/dev/null 2>&1 && sudo dnf -y install \"$p\" || command -v yum >/dev/null 2>&1 && sudo yum -y install \"$p\" || sudo apt-get install -y \"$p\"; }; done",
    "printf '%s' 'dmVyc2lvbj0xLjAuMAo=' | base64 -d > /tmp/.csis-ensure && ( sudo cmp -s /tmp/.csis-ensure '/etc/derivative.conf' || sudo install -m 0644 /tmp/.csis-ensure '/etc/derivative.conf' ) && rm -f /tmp/.csis-ensure",
    "( test -d /opt/derivative/data ) >/dev/null 2>&1 || { sudo mkdir -p /opt/derivative/data; }",
    "echo 'derivative setup'",
    "sudo mkdir -p /opt/derivative && echo 1.0.0 | sudo tee /opt/derivative/VERSION",
  ]
}
  # identity activation for owning group 'coops' (okta)
  provisioner "shell" {
    only   = ["googlecompute.imgfile-basic-dask"]
    inline = [
      "# identity activation for group 'coops' (okta) on image imgfile-basic-dask",
      "sudo mkdir -p /etc/sft",
      "printf 'Labels:\\n  tx.group: coops\\n' | sudo tee /etc/sft/sftd.yaml",
      "sudo systemctl enable sftd",
    ]
  }
  # local modification bundle for imgfile-basic-dask -> /opt/csis/mods (re-run with `csis-mods rerun`)
  provisioner "shell" {
    only   = ["googlecompute.imgfile-basic-dask"]
    inline = ["mkdir -p /tmp/csis-mods"]
  }
  provisioner "file" {
    only        = ["googlecompute.imgfile-basic-dask"]
    source      = "csis-mods/imgfile-basic-dask/"
    destination = "/tmp/csis-mods"
  }
  provisioner "shell" {
    only   = ["googlecompute.imgfile-basic-dask"]
    inline = [
      "sudo rm -rf /opt/csis/mods && sudo mkdir -p /opt/csis",
      "sudo mv /tmp/csis-mods /opt/csis/mods",
      "sudo install -m 0755 /opt/csis/mods/csis-mods /usr/local/bin/csis-mods",
      "sudo chmod -R go-w /opt/csis/mods",
    ]
  }
  # in-bake verification for instance image imgfile-basic-dask: 5 assertion(s)
  provisioner "shell" {
    only   = ["googlecompute.imgfile-basic-dask"]
    inline = [
      "set -e",
      "# verify: activated for group 'coops'",
      "grep -q 'tx.group: coops' /etc/sft/sftd.yaml",
      "systemctl is-enabled sftd >/dev/null 2>&1",
      "rpm -q git >/dev/null 2>&1 || { command -v dpkg >/dev/null 2>&1 && dpkg -s git >/dev/null 2>&1; }",
      "( git --version ) 2>&1 | grep -q -- 'git version'",
      "id -u csisadmin >/dev/null 2>&1",
    ]
  }
  # runtime bake finalization (gcloud-east1)
  provisioner "shell" {
    only   = ["googlecompute.imgfile-basic-dask"]
    inline = [
      "set -e",
      "# finding 47: the build user must leave the image a clean google-sudoers member",
      "getent group google-sudoers >/dev/null 2>&1 && sudo gpasswd -a \"$(whoami)\" google-sudoers >/dev/null || true",
    ]
  }
  post-processor "manifest" {
    output     = "manifest.json"
    strip_path = true
  }
}