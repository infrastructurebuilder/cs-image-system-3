# Build configuration for Packer EBS Ansible Builder generated by PackerDockerImageBuilder (pckr-docker)
build {
  name = "pckr-docker-block-000"
  sources = [
"source.docker.rh10-container"
]
  # before anything else: the build machine settles (docker-fixture)
  provisioner "shell" {
    only   = ["docker.rh10-container"]
    inline = [
      "# before any package work: the machine's own first-boot script has ended (bounded)",
      "if command -v cloud-init >/dev/null 2>&1; then timeout 300 cloud-init status --wait >/dev/null 2>&1 || true; fi",
      "# a container settles at once; it may lack sudo and python3, which the steps that follow use",
      "if ! command -v sudo >/dev/null 2>&1 || ! command -v python3 >/dev/null 2>&1; then if command -v apt-get >/dev/null 2>&1; then apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq sudo python3 procps >/dev/null; elif command -v dnf >/dev/null 2>&1; then dnf -y -q install sudo python3 procps-ng >/dev/null; elif command -v microdnf >/dev/null 2>&1; then microdnf -y install sudo python3 procps-ng >/dev/null; fi; fi",
      "# the step runner: a step that fails on a held package database is run again (never in the image: /run is a tmpfs)",
      "sudo tee /run/csis-step >/dev/null <<'CSIS_STEP'",
      "#!/bin/sh",
      "# cs-image-system: runs ONE step of a bake. A step that fails while the package",
      "# database is held by another process is run again after a wait; any other",
      "# failure is the step's own and is returned at once.",
      "tries=\"$${CSIS_STEP_TRIES:-10}\"",
      "pause=\"$${CSIS_STEP_WAIT:-30}\"",
      "out=\"$(mktemp)\" || exit 1",
      "trap 'rm -f \"$out\" \"$out.rc\"' EXIT",
      "n=1",
      "while :; do",
      "  { \"$@\" 2>&1; echo \"$?\" > \"$out.rc\"; } | tee \"$out\"",
      "  rc=\"$(cat \"$out.rc\")\"",
      "  [ \"$rc\" = 0 ] && exit 0",
      "  [ \"$n\" -ge \"$tries\" ] && exit \"$rc\"",
      "  grep -Eq 'transaction lock|Could not get lock|dpkg frontend lock|Unable to lock the administration directory' \"$out\" || exit \"$rc\"",
      "  echo \"csis-step: the package database was held by another process (attempt $n of $tries); this step runs again in $pause seconds\"",
      "  n=$((n + 1))",
      "  sleep \"$pause\"",
      "done",
      "CSIS_STEP",
      "sudo chmod 0755 /run/csis-step",
    ]
  }
  # OS update for base image rh10-container (policy=security, packages=[], exclude=['kernel*'], pin={}, rhel)
  provisioner "shell" {
    only   = ["docker.rh10-container"]
    execute_command = "chmod +x {{ .Path }}; if [ -r /run/csis-step ]; then {{ .Vars }} sh /run/csis-step {{ .Path }}; else {{ .Vars }} {{ .Path }}; fi"
    inline = ["# subscription-managed systems get their repos enabled; RHUI/PAYG images skip", "if sudo subscription-manager identity >/dev/null 2>&1; then sudo subscription-manager refresh; sudo subscription-manager repos --disable='*'; sudo subscription-manager repos --enable='rhel-10-for-x86_64-baseos-rpms' --enable='rhel-10-for-x86_64-appstream-rpms' --enable='codeready-builder-for-rhel-10-x86_64-rpms'; else echo 'not subscription-registered (RHUI image): using vendor repos as-is'; fi", "sudo dnf clean all", "sudo dnf -y update --security --exclude=kernel* || { sudo dnf clean all; sudo dnf -y update --security --exclude=kernel*; }", "sudo mkdir -p /var/lib/csis", "( rpm -qa --qf '%%{NAME}-%%{VERSION}-%%{RELEASE}.%%{ARCH}\n' 2>/dev/null || dpkg-query -W -f='$${Package}=$${Version}\n' ) | sort | sudo tee /var/lib/csis/packages.txt >/dev/null"]
  }
  # admin user csisadmin (1 public key(s))
  provisioner "shell" {
    only   = ["docker.rh10-container"]
    execute_command = "chmod +x {{ .Path }}; if [ -r /run/csis-step ]; then {{ .Vars }} sh /run/csis-step {{ .Path }}; else {{ .Vars }} {{ .Path }}; fi"
    inline = [
      "# mandatory local admin user 'csisadmin' (DESIGN Q2/N9): public keys only",
      "id -u csisadmin >/dev/null 2>&1 || sudo useradd -m -s /bin/bash csisadmin",
      "echo 'csisadmin ALL=(ALL) NOPASSWD:ALL' | sudo tee /etc/sudoers.d/90-csisadmin >/dev/null && sudo chmod 0440 /etc/sudoers.d/90-csisadmin",
      "sudo mkdir -p /home/csisadmin/.ssh && sudo chmod 0700 /home/csisadmin/.ssh",
      "sudo rm -f /home/csisadmin/.ssh/authorized_keys",
      "echo 'ENC[age:]' | sudo tee -a /home/csisadmin/.ssh/authorized_keys >/dev/null",
      "sudo touch /home/csisadmin/.ssh/authorized_keys && sudo chmod 0600 /home/csisadmin/.ssh/authorized_keys",
      "sudo chown -R csisadmin:csisadmin /home/csisadmin/.ssh",
    ]
  }
  # identity type 'posix' prerequisites, dormant
  provisioner "shell" {
    only   = ["docker.rh10-container"]
    execute_command = "chmod +x {{ .Path }}; if [ -r /run/csis-step ]; then {{ .Vars }} sh /run/csis-step {{ .Path }}; else {{ .Vars }} {{ .Path }}; fi"
    inline = [
      "# identity type 'posix' prerequisites (posix-local): the shadow tools and sudo, present on every supported family -- checked, not installed",
      "command -v groupadd >/dev/null && command -v useradd >/dev/null && command -v gpasswd >/dev/null && command -v visudo >/dev/null",
    ]
  }
  # storage type 'volume' prerequisites
  provisioner "shell" {
    only   = ["docker.rh10-container"]
    execute_command = "chmod +x {{ .Path }}; if [ -r /run/csis-step ]; then {{ .Vars }} sh /run/csis-step {{ .Path }}; else {{ .Vars }} {{ .Path }}; fi"
    inline = [
      "# storage type 'volume' declared: no prerequisites to bake (docker-volume)",
    ]
  }
  # in-bake verification for base image rh10-container: 8 assertion(s)
  provisioner "shell" {
    only   = ["docker.rh10-container"]
    inline = [
      "set -e",
      "# verify: admin user csisadmin",
      "id -u csisadmin >/dev/null 2>&1",
      "sudo test -f /home/csisadmin/.ssh/authorized_keys",
      "sudo grep -q -- \"$(echo 'ENC[age:]' | awk '{print $2}')\" /home/csisadmin/.ssh/authorized_keys",
      "# verify: groupadd, useradd, gpasswd, visudo present",
      "command -v groupadd >/dev/null",
      "command -v useradd >/dev/null",
      "command -v gpasswd >/dev/null",
      "command -v visudo >/dev/null",
      "( id -u csisadmin ) >/dev/null 2>&1; test $? -eq 0",
    ]
  }
  # stage 103: the build's names are tags (rh10-container); the floating tag is the series' newest
  post-processor "docker-tag" {
    only       = ["docker.rh10-container"]
    repository = "csis/fixture"
    tags       = ["rh10-container-docker-fixture-20260826_120000", "rh10-container-docker-fixture"]
  }
  post-processor "manifest" {
    output     = "manifest.json"
    strip_path = true
  }
}